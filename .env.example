# Optional: add a Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically if the primary model keeps returning temporary 5xx errors.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Optional: configure a Judge0-compatible isolated execution service.
# Use only a trusted provider; do not execute untrusted code directly on your machine.
JUDGE0_URL=
JUDGE0_API_KEY=
