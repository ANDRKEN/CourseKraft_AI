# Copy this file to .env and replace placeholders as needed.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_name
JUDGE0_URL=https://your-judge0-host.example
JUDGE0_API_KEY=your_judge0_api_key_here
PORT=5000

# Optional, comma-separated Gemini model fallbacks
GEMINI_FALLBACK_MODELS=
# Set provider-specific runner authentication header and language IDs when required
JUDGE0_API_KEY_HEADER=
JUDGE0_LANGUAGE_IDS=
